# MediaWiki Configuration
MEDIAWIKI_URL=https://example.com/wiki
MEDIAWIKI_BOT_USER=YourBotUsername
MEDIAWIKI_BOT_PASSWORD=your_bot_password_or_oauth_token
MEDIAWIKI_USER_AGENT=MediaWikiAgent/1.0 (User:YourUsername)

# LLM Configuration
LLM_PROVIDER=openai  # Options: openai, anthropic, local
LLM_MODEL=gpt-4
LLM_API_KEY=your_api_key_here
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# Vector Store Configuration
VECTOR_DB_TYPE=faiss  # Options: faiss, pinecone, milvus
# VECTOR_DB_URL=  # Required for pinecone/milvus

# Cache Configuration
CACHE_BACKEND=memory  # Options: redis, memory
# REDIS_URL=redis://localhost:6379/0  # Required for redis backend
CACHE_TTL=3600  # Seconds

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=INFO

# Agent Configuration
BOT_EDIT_DELAY=5  # Seconds between edits
MAX_CONCURRENT_REQUESTS=5
ENABLE_WRITE_OPERATIONS=false  # Set to true after testing

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log
