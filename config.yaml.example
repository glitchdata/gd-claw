# MediaWiki AI Agent Configuration File
# Copy this to config.yaml and customize for your instance

mediawiki:
  url: https://example.com/wiki
  timeout: 30
  verify_ssl: true
  
  api:
    read_timeout: 30
    write_timeout: 60
    connect_timeout: 10
  
  rate_limiting:
    reads_per_second: 1
    edits_per_second: 0.2  # One edit every 5 seconds
    batch_size: 100
  
  auth:
    method: oauth2  # Options: oauth2, bot_password
    # For bot_password: username and password in .env
    # For oauth2: client_id and client_secret in .env

indexing:
  auto_sync: true
  sync_interval_hours: 24
  
  initial_sync:
    enabled: true
    batch_size: 100
    namespaces: [0, 10, 14]  # ArticleNamespace, Templates, Categories
  
  incremental_sync:
    enabled: true
    check_interval_minutes: 60
    lookback_hours: 24

ai:
  llm:
    provider: openai  # Options: openai, anthropic, local
    model: gpt-4
    temperature: 0.7
    max_tokens: 2000
    top_p: 0.9
  
  embeddings:
    model: sentence-transformers/all-MiniLM-L6-v2
    dimension: 384
    cache: true

vector_store:
  type: faiss  # Options: faiss, pinecone, milvus
  
  faiss:
    index_type: IVFFlat  # Options: IVFFlat, HNSW, Flat
    nlist: 100
    nprobe: 10
  
  # pinecone:
  #   environment: us-west1-gcp
  #   api_key: ${PINECONE_API_KEY}
  
  similarity_metric: cosine  # cosine, euclidean, dot

cache:
  backend: memory  # Options: redis, memory
  
  memory:
    max_size: 1000
  
  # redis:
  #   url: redis://localhost:6379/0
  #   ttl: 3600
  #   key_prefix: mediawiki_agent

database:
  type: sqlite  # Options: sqlite, postgresql
  
  sqlite:
    path: ./data/agent.db
  
  # postgresql:
  #   host: localhost
  #   port: 5432
  #   database: mediawiki_agent
  #   user: ${DB_USER}

agent:
  name: MediaWikiAgent
  description: Knowledge base manager for MediaWiki
  
  capabilities:
    - extract      # Extract entities and facts
    - analyze      # Analyze page quality
    - suggest      # Generate suggestions
    - edit         # Create/edit pages
    - delete       # Delete pages
    - search       # Search content
  
  features:
    content_analysis: true
    quality_scoring: true
    recommendation_engine: true
    conflict_resolution: true
    dry_run_mode: true  # Test edits without committing
  
  write_safety:
    enabled: true
    whitelist_mode: true
    whitelisted_pages: []  # Empty = all pages allowed
    whitelisted_categories: []
    require_edit_summary: true
    min_edit_summary_length: 10

operations:
  queue:
    enabled: true
    persistence: sqlite
    max_retries: 3
    retry_delay_seconds: 300
  
  edit_scheduling:
    enabled: true
    batch_updates: true
    max_batch_size: 10

monitoring:
  metrics:
    enabled: true
    prometheus_port: 8001
  
  logging:
    level: INFO
    file: logs/agent.log
    max_file_size_mb: 100
    backup_count: 5

api:
  host: 0.0.0.0
  port: 8000
  log_level: INFO
  
  cors:
    enabled: true
    allowed_origins:
      - http://localhost:3000
      - http://localhost:8000
  
  rate_limiting:
    enabled: true
    requests_per_minute: 100

development:
  debug: false
  enable_test_endpoints: false  # Enable /test and /health_detailed
  mock_llm: false  # Use mock LLM for testing
